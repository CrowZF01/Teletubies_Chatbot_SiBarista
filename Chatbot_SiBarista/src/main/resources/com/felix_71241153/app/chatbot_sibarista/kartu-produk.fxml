<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #FBF7F0; -fx-background-radius: 12; -fx-border-color: #C8A882; -fx-border-width: 1; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
    </padding>

    <StackPane minHeight="70.0" minWidth="100.0" prefHeight="70.0" prefWidth="70.0" style="-fx-background-color: #F0E6D3; -fx-background-radius: 10;">
        <ImageView fx:id="imgProduk" fitHeight="70.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="false" />
    </StackPane>

    <VBox alignment="CENTER_LEFT" spacing="3.0" HBox.hgrow="ALWAYS">
        <Label fx:id="lblNama" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1C0A00;" wrapText="true" />
        <Label fx:id="lblHarga" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3D1A00;" />
    </VBox>
    <Button fx:id="btnTambah" mnemonicParsing="false" style="-fx-background-color: #1C0A00; -fx-text-fill: #FBF7F0; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 50%; -fx-min-width: 36px; -fx-min-height: 36px; -fx-max-width: 36px; -fx-max-height: 36px; -fx-padding: 0;" text="+" />
</HBox>