<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="500.0" prefHeight="550.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OpsiFormController">

    <VBox spacing="5.0" style="-fx-background-color: #4A3020; -fx-padding: 20; -fx-background-radius: 15 15 0 0;">
        <Label text="Kelola Opsi Custom Kopi" textFill="#E8C882">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label text="Pilihan ini akan otomatis muncul pada semua menu berkategori Coffee" textFill="#D4B896">
            <font><Font size="11.0" /></font>
        </Label>
    </VBox>

    <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">

        <TableView fx:id="opsiTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D4B896;">
            <columns>
                <TableColumn fx:id="colNo" prefWidth="50.0" text="NO" />
                <TableColumn fx:id="colGrup" prefWidth="180.0" text="Grup Kustom (grup_opsi)" />
                <TableColumn fx:id="colNama" prefWidth="200.0" text="Nama Pilihan (nama_opsi)" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <VBox spacing="8.0" style="-fx-padding: 10; -fx-background-color: #F5F0EA; -fx-background-radius: 10; -fx-border-color: #D4B896; -fx-border-radius: 10;">
            <Label text="TAMBAH PILIHAN BARU" textFill="#4A3020">
                <font><Font name="System Bold" size="11.0" /></font>
            </Label>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <TextField fx:id="txtGrup" promptText="Contoh: Suhu / Gula / Biji" style="-fx-border-color: #D4B896; -fx-border-radius: 5; -fx-background-radius: 5;" />
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <TextField fx:id="txtNama" promptText="Contoh: Panas / Less Sugar" style="-fx-border-color: #D4B896; -fx-border-radius: 5; -fx-background-radius: 5;" />
                </VBox>
                <Button onAction="#handleTambah" style="-fx-background-color: #4A3020; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Tambah" prefHeight="30.0"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button onAction="#handleDelete" style="-fx-background-color: #FFE5E5; -fx-text-fill: #C44A4A; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="✕ Hapus Pilihan" prefWidth="130.0" prefHeight="30.0"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleClose" style="-fx-background-color: transparent; -fx-text-fill: #8B7560; -fx-cursor: hand;" text="Tutup" prefWidth="80.0"/>
        </HBox>
    </VBox>
</VBox>