<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="520" style="-fx-background-color: #F0E6D3;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KeranjangController">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TOP : Header                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <top>
        <VBox style="-fx-background-color: #1C0A00;">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #1C0A00;">
                <padding><Insets bottom="14" left="16" right="20" top="14" /></padding>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Judul -->
                <Label style="-fx-text-fill: #FBF7F0;                               -fx-font-size: 20px;                               -fx-font-weight: bold;" text="🛒  Keranjang" />

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- ── Filter Kategori ── -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #3D1A00;">
                <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>

                <Button fx:id="btnFilterSemua" onAction="#handleFilterSemua" style="-fx-background-color: #C8A882; -fx-text-fill: #1C0A00;                    -fx-font-size: 12px; -fx-cursor: hand;                    -fx-background-radius: 20; -fx-padding: 5 14 5 14;                    -fx-font-weight: bold;" text="☕ Semua" />
                <Button fx:id="btnFilterKopi" onAction="#handleFilterKopi" style="-fx-background-color: transparent; -fx-text-fill: #C8A882;                    -fx-font-size: 12px; -fx-cursor: hand;                    -fx-border-color: #C8A882; -fx-border-radius: 20;                    -fx-border-width: 1; -fx-background-radius: 20;                    -fx-padding: 5 14 5 14;" text="Kopi" />
                <Button fx:id="btnFilterNonKopi" onAction="#handleFilterNonKopi" style="-fx-background-color: transparent; -fx-text-fill: #C8A882;                    -fx-font-size: 12px; -fx-cursor: hand;                    -fx-border-color: #C8A882; -fx-border-radius: 20;                    -fx-border-width: 1; -fx-background-radius: 20;                    -fx-padding: 5 14 5 14;" text="Non-Kopi" />
                <Button fx:id="btnFilterMakanan" onAction="#handleFilterMakanan" style="-fx-background-color: transparent; -fx-text-fill: #C8A882;                    -fx-font-size: 12px; -fx-cursor: hand;                    -fx-border-color: #C8A882; -fx-border-radius: 20;                    -fx-border-width: 1; -fx-background-radius: 20;                    -fx-padding: 5 14 5 14;" text="Snack" />
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  CENTER : Daftar Menu (kiri) + Keranjang (kanan)                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <center>
        <HBox spacing="0">

            <!-- ── Panel Kiri : Daftar Menu ── -->
            <VBox prefWidth="550" style="-fx-background-color: #F0E6D3;" VBox.vgrow="ALWAYS">

                <!-- Sub-header -->
                <HBox alignment="CENTER_LEFT">
                    <padding><Insets bottom="6" left="16" right="12" top="14" /></padding>
                    <Label fx:id="sectionTitle" style="-fx-font-size: 15px; -fx-font-weight: bold;                                   -fx-text-fill: #3D1A00;" text="Semua Menu" />
                </HBox>

                <!-- Daftar produk dari DB -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;                                    -fx-background: transparent;                                    -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="menuListContainer" spacing="0">
                        <padding><Insets bottom="12" left="12" right="12" top="4" /></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ── Divider vertikal ── -->
            <Separator orientation="VERTICAL" style="-fx-background-color: #C8A882;" />

            <!-- ── Panel Kanan : Keranjang ── -->
            <VBox prefWidth="320" style="-fx-background-color: #FBF7F0;" HBox.hgrow="ALWAYS">

                <!-- Sub-header -->
                <HBox alignment="CENTER_LEFT">
                    <padding><Insets bottom="6" left="16" right="12" top="14" /></padding>
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold;                                   -fx-text-fill: #3D1A00;" text="🛒  Pesanan Saya" />
                </HBox>

                <!-- Item keranjang -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;                                    -fx-background: transparent;                                    -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="cartItemContainer" spacing="0">
                        <padding><Insets bottom="12" left="10" right="10" top="4" /></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  BOTTOM : Total Harga + Tombol Checkout                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <bottom>
        <VBox style="-fx-background-color: #1C0A00;">
            <Separator style="-fx-background-color: #C8A882;" />

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets bottom="14" left="20" right="20" top="14" /></padding>

                <VBox spacing="2">
                    <Label style="-fx-text-fill: #C8A882;                                   -fx-font-size: 11px;                                   -fx-font-style: italic;" text="Total Harga" />
                    <Label fx:id="totalLabel" style="-fx-text-fill: #FBF7F0;                                   -fx-font-size: 18px;                                   -fx-font-weight: bold;" text="Rp 0" />
                </VBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Tombol Checkout -->
                <Button onAction="#handleCheckout" style="-fx-background-color: #C8A882;                                -fx-text-fill: #1C0A00;                                -fx-font-size: 14px;                                -fx-font-weight: bold;                                -fx-cursor: hand;                                -fx-background-radius: 8;                                -fx-padding: 10 24 10 24;" text="Cek Harga →" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
